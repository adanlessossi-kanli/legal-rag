OPENAI_API_KEY=your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.7
SOURCE_TEXT_MAX_LENGTH=200
VECTOR_SEARCH_INDEX=vector_index
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=5/minute
MAX_HISTORY_MESSAGES=20
MAX_QUESTION_LENGTH=2000
OPENAI_MAX_RETRIES=3
ENABLE_QUERY_REWRITING=true
LOG_FORMAT=json

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ENABLE_CSP=true

# Redis cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# Hybrid search + reranking
ENABLE_HYBRID_SEARCH=true
KEYWORD_SEARCH_LIMIT=10
ENABLE_RERANKING=true
RERANK_MODEL=gpt-4o-mini

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Ingestion queue
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY_SECONDS=30

# MongoDB
MONGODB_HOST=cluster0.xxxxx.mongodb.net
MONGODB_PORT=27017
MONGODB_CLIENT_ID=your-atlas-service-account-client-id
MONGODB_CLIENT_SECRET=your-atlas-service-account-client-secret
MONGODB_DB=legal_rag
MONGODB_OPTIONS=retryWrites=true&w=majority

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
